# codex-telegram-bot — example environment file.
#
# Copy this to $HOME/.config/codex-telegram-bot/bot.env, fill in the two secrets,
# and chmod 600 it. Nothing here contains a real value.
#
#   install -d -m 700 "$HOME/.config/codex-telegram-bot"
#   cp .env.example  "$HOME/.config/codex-telegram-bot/bot.env"
#   chmod 600        "$HOME/.config/codex-telegram-bot/bot.env"
#   $EDITOR          "$HOME/.config/codex-telegram-bot/bot.env"
#
# A systemd EnvironmentFile= is NOT a shell script: no `export`, no command
# substitution, no multi-line values. One KEY=value per line. Quote only if a
# value really contains a space, and use double quotes.
#
# Every path must be absolute. The bot refuses to start otherwise, because a
# relative path resolves against whatever working directory systemd happens to
# use, which is not the directory you meant.

# --- required ---------------------------------------------------------------

# The bot token from @BotFather. Treat it like a password: whoever holds it
# controls the bot. The bot never logs it, never passes it to Codex, and strips
# it from the child environment.
TELEGRAM_BOT_TOKEN=123456789:REPLACE-with-the-real-token-from-BotFather

# Numeric Telegram user ids allowed to drive Codex, comma or space separated.
# Usernames are NOT accepted: they can be renamed by anyone, so they are not an
# identity. Get yours before starting the bot — see README.md.
# Keep this list short: everyone on it can run a coding agent on this host.
ALLOWED_TELEGRAM_USER_IDS=111111111

# The Git repository Codex works in. It must already exist and contain a .git
# entry, because Codex requires a repository and so does this bot. The agent can
# read and (under workspace-write) modify everything in it, so give it only what
# it should be allowed to touch.
BOT_WORKSPACE=/home/YOURUSER/codex-bot-workspace

# Where the bot keeps its SQLite database and its poller lock. Must be OUTSIDE
# BOT_WORKSPACE: Codex can write to the workspace, and the agent must not be able
# to edit the bot's own bookkeeping. Created 0700 if it does not exist.
BOT_STATE_DIR=/home/YOURUSER/.local/share/codex-telegram-bot

# The Codex executable, from `command -v codex` for the account that runs the
# bot. A bare name is resolved on PATH, but an absolute path is better in a
# service unit, where PATH is minimal.
BOT_CODEX_BIN=/home/YOURUSER/.local/bin/codex

# A dedicated Codex home for this bot: its login cache and its session history.
# Must be absolute, must NOT be your interactive ~/.codex (the bot refuses to
# start if it is, so it can never see or resume your own sessions), and must be
# outside BOT_WORKSPACE. Created 0700 if it does not exist.
#
# Log in under exactly this value, as the same account that runs the bot:
#   CODEX_HOME=/home/YOURUSER/.local/share/codex-telegram-bot/codex codex login --device-auth
CODEX_HOME=/home/YOURUSER/.local/share/codex-telegram-bot/codex

# --- optional: Codex behaviour ---------------------------------------------

# The sandbox policy for model-generated commands.
#   workspace-write  Codex may edit files inside BOT_WORKSPACE (the default)
#   read-only        Codex may only look; use this for a question-answering bot
# danger-full-access is rejected outright and cannot be configured.
#BOT_SANDBOX_MODE=workspace-write

# Pass --strict-config so Codex fails loudly on an unrecognised configuration
# key instead of silently ignoring the sandbox override. Default true. Turn it
# off only if a Codex downgrade makes your config.toml look unknown.
#BOT_CODEX_STRICT_CONFIG=true

# A model to pass as `-m`. Empty means whatever CODEX_HOME/config.toml says.
#BOT_CODEX_MODEL=gpt-5-codex

# How long one Codex turn may run before the process group is terminated.
# 30s..24h. Default 15m. Raise it for long build or refactor tasks.
#BOT_TURN_TIMEOUT=15m

# Check `codex login status` at startup and warn if the bot's CODEX_HOME has no
# credentials. Default true. It is a warning, not a failure: the probe can fail
# for reasons that have nothing to do with login.
#BOT_CHECK_CODEX_LOGIN=true

# --- optional: concurrency --------------------------------------------------

# How long a message waits for its turn to be allowed to start before the bot
# answers "busy" instead. Only one Codex turn can touch the workspace at a time,
# because Codex edits files. Default 5m.
#BOT_QUEUE_TIMEOUT=5m

# How many turns may be queued or running at once. Over the limit, a message is
# refused immediately with a clear answer rather than queueing without bound.
# The poller never blocks on this, so /stop always gets through. Default 8.
#BOT_MAX_CONCURRENT_UPDATES=8

# Send a "still working" message if a turn is still running after this long.
# 0 disables it. Default 10s.
#BOT_ACK_AFTER=10s

# How long a shutdown waits for in-flight turns to finish before cancelling
# them. Codex may be mid-edit, so finishing is usually better than being killed.
# Default 20s.
#BOT_SHUTDOWN_GRACE=20s

# --- optional: Telegram -----------------------------------------------------

# How many updates one getUpdates call returns. Telegram's maximum is 100.
#BOT_POLL_LIMIT=100

# Server-side long-poll wait, in seconds. 0..120. Default 25.
#BOT_POLL_TIMEOUT_SEC=25

# Delete any configured webhook at startup. Default true, and you almost
# certainly want it: a webhook and a poller are mutually exclusive, and with a
# webhook set, getUpdates keeps answering 409 while the bot looks alive.
# Pending updates are never dropped, so messages sent while the bot was down are
# still delivered.
#BOT_DELETE_WEBHOOK=true

# Only for testing against a local Bot API server. Leave it alone in production.
#BOT_TELEGRAM_API_BASE=https://api.telegram.org

# --- optional: limits and logging -------------------------------------------

# Maximum message text, in UTF-16 code units. Telegram's hard limit is 4096 and
# longer replies are split; lowering this only makes the chunks smaller.
#BOT_MAX_REPLY_CHARS=4096

# How much of Codex's stderr is kept for diagnostics. Default 65536.
#BOT_MAX_STDERR_BYTES=65536

# Longest JSONL event line accepted from Codex; longer lines are skipped rather
# than allowed to grow memory. Default 8388608.
#BOT_MAX_EVENT_BYTES=8388608

# debug, info, warn or error. Default info.
#BOT_LOG_LEVEL=info

# Log the text of user prompts. Default FALSE: by default the log records prompt
# lengths, never their content. Turn it on only when debugging, and remember the
# journal may be readable by more people than the chat is.
#BOT_LOG_PROMPTS=false
